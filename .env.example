# ------------------------------------------------------------------
# LinkedIn Growth OS — environment configuration (placeholders only)
# Copy to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user id of the only allowed user (get from @userinfobot)
TELEGRAM_ALLOWED_USER_ID=

# --- Database ---
DATABASE_URL=sqlite:///./data/linkedin_growth.db

# --- Time ---
TIMEZONE=Asia/Tehran

# --- Strategy ---
PUBLISHING_TARGET_PER_WEEK=3
MAX_DAILY_TASKS=3
DEFAULT_CONTENT_LANGUAGE=en
# Content pillar proportions (JSON, should sum to ~1.0)
CONTENT_PILLARS={"open_source_deep_dive":0.30,"tool_experiment":0.30,"personal_project":0.25,"educational_post":0.15}
# Idea prioritisation weights (JSON)
IDEA_WEIGHTS={"audience_relevance":0.25,"demonstrability":0.20,"technical_depth":0.20,"business_relevance":0.25,"effort_required":0.10}

# --- Optional LLM (leave empty to disable) ---
# e.g. anthropic / openai
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Optional: override the provider's API base URL (proxies / self-hosted endpoints)
AI_BASE_URL=
